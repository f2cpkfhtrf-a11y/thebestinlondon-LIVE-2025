{
  "name": "the-best-in-london",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0 <21.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "data:refresh": "node scripts/refresh-data.js",
    "data:version": "node scripts/add-version-to-data.js",
    "data:rebuild-trigger": "node scripts/force-vercel-rebuild.js",
    "verify:production": "node scripts/verify-production.js",
    "images:fix-failed": "tsx scripts/processFailedVenues.ts",
    "images:validate": "node scripts/validateImages.js",
    "images:list-missing": "node scripts/listMissing.js",
    "images:scan-code": "node scripts/scanCode.js",
    "images:report": "node scripts/generateReport.js",
    "audit:images": "tsx scripts/validateLocalImages.ts",
    "audit:images:fix": "tsx scripts/auditAndFixImages.ts",
    "audit:tiles": "tsx scripts/auditTiles.ts",
    "audit:all": "npm run audit:images && npm run audit:tiles",
    "audit:files": "tsx scripts/auditFiles.ts",
    "audit:routes": "tsx scripts/auditRoutes.ts",
    "audit:links": "tsx scripts/checkLinks.ts",
    "audit:summary": "tsx scripts/generateAuditSummary.ts",
    "audit:complete": "npm run audit:files && npm run audit:routes && npm run audit:links && npm run audit:images && npm run audit:summary",
    "audit:seo": "node scripts/auditSEO.ts",
    "images:lqip": "tsx scripts/generateLqip.ts",
    "analyze": "ANALYZE=true next build",
    "post:verify": "node scripts/postDeployVerify.mjs",
    "verify:preprod": "node scripts/postDeployVerify.mjs",
    "deploy:preflight": "npm run audit:complete && next build",
    "deploy:prebuilt": "npx vercel deploy --prebuilt --prod --yes --archive=tgz",
    "deploy:auto": "node scripts/vercelAutoRetry.mjs",
    "deploy:verify": "node scripts/postDeployVerify.mjs --report reports/post_deploy_verification.json",
    "fix:tiles": "node scripts/fixMissingTileImages.mjs",
    "content:gen": "node scripts/generateContent.mjs",
    "content:verify": "node scripts/verifyContent.mjs",
    "verify:content": "node scripts/verifyContent.mjs",
    "verify:content:live": "node scripts/verifyContent.mjs --live",
    "content:refresh": "npm run content:gen && npm run content:verify",
    "seed:blog": "node scripts/seedBlog.mjs",
    "seed:faq": "node scripts/seedFaq.mjs",
    "external:fetch": "node scripts/fetchExternalContent.mjs",
    "external:verify": "node scripts/verifyExternalFreeze.mjs",
    "external:refresh": "npm run external:fetch && npm run external:verify",
    "images:fix+verify": "npm run images:validate && node scripts/verifyLocalImages.mjs",
    "postbuild": "echo 'Post-build completed'"
  },
  "dependencies": {
    "@types/marked": "^5.0.2",
    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.545.0",
    "marked": "^16.4.1",
    "next": "^13.5.11",
    "node-fetch": "^3.3.2",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "13.5.6",
    "postcss": "^8",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6"
  }
}
