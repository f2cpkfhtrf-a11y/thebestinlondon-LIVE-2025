<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#0a0a0a;stop-opacity:1" />
              <stop offset="30%" style="stop-color:#1a1a2e;stop-opacity:1" />
              <stop offset="70%" style="stop-color:#16213e;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#0a0a0a;stop-opacity:1" />
            </linearGradient>
            <pattern id="city" x="0" y="0" width="300" height="300" patternUnits="userSpaceOnUse">
              <rect x="0" y="200" width="50" height="100" fill="#D4AF37" opacity="0.3"/>
              <rect x="60" y="180" width="40" height="120" fill="#D4AF37" opacity="0.4"/>
              <rect x="120" y="190" width="45" height="110" fill="#D4AF37" opacity="0.3"/>
              <rect x="200" y="170" width="35" height="130" fill="#D4AF37" opacity="0.4"/>
              <circle cx="100" cy="100" r="3" fill="#D4AF37" opacity="0.6"/>
              <circle cx="200" cy="80" r="2" fill="#D4AF37" opacity="0.5"/>
              <circle cx="250" cy="120" r="2.5" fill="#D4AF37" opacity="0.6"/>
            </pattern>
          </defs>
          <rect width="1920" height="1080" fill="url(#bg)"/>
          <rect width="1920" height="1080" fill="url(#city)" opacity="0.12"/>
          <text x="960" y="350" font-family="Georgia, serif" font-size="72" fill="#D4AF37" text-anchor="middle" dominant-baseline="middle" font-weight="bold">LATE NIGHT LONDON</text>
          <text x="960" y="450" font-family="Arial, sans-serif" font-size="36" fill="#ffffff" text-anchor="middle" dominant-baseline="middle">24/7 Dining Scene</text>
          <text x="960" y="500" font-family="Arial, sans-serif" font-size="28" fill="#D4AF37" text-anchor="middle" dominant-baseline="middle">Where London Never Sleeps</text>
          <rect x="760" y="550" width="400" height="3" fill="#D4AF37" opacity="0.7"/>
        </svg>